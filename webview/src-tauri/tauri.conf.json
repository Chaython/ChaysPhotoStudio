{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chays Photo Studio",
  "version": "1.3.0",
  "identifier": "ca.live.chaython.chays-photo-studio.webview",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../build/webapp-export"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chay's Photo Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#1c1c1c",
        "dataDirectory": "profile-v2-no-pwa"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Photoshop-class image editor",
    "longDescription": "Chay's Photo Studio — a Photoshop-class raster image editor that runs in a native system webview. Free for consumer and education use; commercial licensing: chaython@live.ca.",
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif",
          "bmp",
          "tif",
          "tiff",
          "avif",
          "psd",
          "psb",
          "pdf",
          "svg",
          "ora",
          "xcf",
          "dng",
          "cr2",
          "cr3",
          "nef",
          "arw",
          "raf",
          "rw2",
          "orf",
          "heic",
          "heif",
          "jxl",
          "jp2",
          "exr",
          "hdr",
          "fits",
          "dcm",
          "mp4",
          "webm",
          "mkv"
        ],
        "name": "Chays Photo Studio document",
        "role": "Editor",
        "description": "Open in Chays Photo Studio"
      }
    ]
  }
}
