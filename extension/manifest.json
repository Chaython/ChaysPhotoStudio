{
  "manifest_version": 3,
  "name": "Chay's Photo Studio",
  "short_name": "Chay's Photo",
  "version": "1.0.0",
  "description": "Photoshop-class image editor bundled right into the plugin \u2014 no server, works offline. Right-click any image on the web to edit it.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Chay's Photo Studio",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "clipboardRead"
  ],
  "minimum_chrome_version": "102"
}
